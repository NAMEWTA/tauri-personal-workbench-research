{
  "schema_version": 5,
  "interaction_language": "zh-CN",
  "artifact_language": "zh-CN",
  "git": {
    "default_branch": "main"
  },
  "execution": {
    "max_implementation_agents": 7,
    "max_integration_attempts": 10,
    "deep_ticket_human_approval": true,
    "shared_path_owner": "explicit"
  },
  "verification": {
    "test": "pnpm test",
    "typecheck": "pnpm --dir apps/desktop typecheck",
    "lint": "pnpm --dir apps/desktop lint",
    "build": "pnpm build:sidecar && pnpm --dir apps/desktop build"
  },
  "planning": {
    "default_depth": "standard",
    "require_ready_gate": true,
    "require_evidence": true,
    "ui_design_default_candidates": 3,
    "ui_design_max_candidates": 4
  }
}
